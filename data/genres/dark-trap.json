  "sources": [
    "style-research ch.1 §1 Trap",
    "style-research ch.2 §1 Trap melodies — Metro/Southside half-step dissonance"
  ],
  "notes": "Trap with the lights off. The marker is not the drums — it is the deliberate half-step clash inside an otherwise simple line, the device the Metro/Southside school is built on. Harmony stays static for whole sections so the dissonance has nothing to resolve against, and the melody sits in the bell octave above a low-passed pad.",

  "session": {
    "bpm": { "min": 130, "max": 150, "mode": 140 },
    "halfTime": true,
    "keys": { "values": ["Fm", "F#m", "Gm", "Cm", "Bm"], "weights": [3, 3, 2, 2, 2] },
    "scales": { "values": ["natural_minor", "harmonic_minor", "phrygian"], "weights": [4, 3, 3] },
    "swing": { "grid": "16th", "amount": 0.5 },
    "humanize": {
      "quantizeStrength": 0.94,
      "velocityVar": 0.1,
      "timingJitterMs": { "kick": 1, "snare": 1, "clap": 2, "closedHat": 2, "bass808": 1 }
    }
  },

  "drums": {
