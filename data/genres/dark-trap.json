        "positions": ["phrase_end", "pre_snare", "bar_4"],
        "freqPerBar": 0.5,
        "velocityRamp": true
      },
      "openHat": { "prob": 0.25, "pos": ["2&", "4&"], "perBar": [1, 1] },
      "pitchBendProb": 0.08
    },
    "fills": { "smallEveryBars": 2, "bigEveryBars": 8, "snareRollLadder": true },
    "bass808": {
      "role": "bassline",
      "sustain": "legato",
      "monoCutSelf": true,
      "slideProb": 0.35,
      "slidesPer4Bars": [1, 2],
      "slideIntervals": { "values": ["P8", "P5", "m3"], "weights": [3, 3, 2] },
      "slidePositions": ["phrase_end"],
      "register": [17, 31],
      "distortion": "medium",
      "distortionWet": [0.15, 0.3]
    }
  },

