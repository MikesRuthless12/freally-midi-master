{
  "compilerOptions": {
    // ES2022 for `Error.cause`, which this project's own `preserve-caught-error`
    // lint rule requires on every rethrow — the two disagreed at ES2020, and a
    // rule that cannot be satisfied is a rule that gets disabled. Both webview
    // engines this ships in (WebView2, WKWebView) have supported it since 2021.
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
